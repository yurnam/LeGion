{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/recent-inventory-response.schema.json",
  "title": "RecentInventoryResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_ids"],
  "properties": {
    "object_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
